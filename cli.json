{
  "$schema": "https://opencode.ai/v2/cli.json",
  "diffs": {
    "wrap": "word",
    "single": false,
    "view": "auto"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "image_preview": true,
    "markdown": "rendered",
    "permissions": "autoaccept"
  },
  "animations": true,
  "theme": {
    "name": "github",
    "mode": "dark"
  },
  "prompt": {
    "image_preview": true,
    "paste": "full"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.6
  },
  "debug": {
    "devtools": true,
    "turn_tokens": false,
    "timing": false
  },
  "tabs": {
    "layout": "horizontal",
    "indicators": "status",
    "mode": "on"
  },
  "scroll": {
    "speed": 3.25,
    "acceleration": true
  },
  "terminal": {
    "copy": "select"
  }
}
